# Server
HOST=0.0.0.0
PORT=4321

# Required for /control. Use a long, unique value and inject it at runtime.
CONTROL_PASSWORD=

# Speech-to-Text provider (openai | web)
STT_PROVIDER=openai
OPENAI_API_KEY=

# TTS provider (openai | web)
TTS_PROVIDER=openai
TTS_VOICE=fable

# Behavior — see DESIGN.md §32
MAX_STEPS=10
DEFAULT_STEPS=5
LLM_FALLBACK_ENABLED=false
