{
  "name": "robi",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "ROBI — Robot interactivo por voz para presentación escolar",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "tsx ./server.mjs",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "astro check && tsc --noEmit",
    "audios": "node sonidos/generate.mjs",
    "audios:install": "mkdir -p public/audio && cp sonidos/audios/*.mp3 public/audio/"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@ark-ui/react": "5.38.2",
    "@astrojs/node": "11.1.3",
    "@astrojs/react": "6.0.3",
    "astro": "7.2.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
