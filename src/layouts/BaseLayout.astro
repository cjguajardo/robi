---
import "../styles/global.css";

interface Props {
  title: string;
  /** Hide chrome — used by /display fullscreen mode. */
  bare?: boolean;
}

const { title, bare = false } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b1020" />
    <!-- Favicon — modern browsers pick the SVG; PNG/ICO are fallbacks.
         Dark background (matches theme-color) so the favicon reads on
         both light and dark browser tabs. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>{title}</title>
  </head>
  <body class:list={[bare && "bare"]}>
    <slot />
  </body>
</html>
